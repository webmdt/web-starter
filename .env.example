# Copy to `.env.local` and fill in values. Never commit real secrets.
# All variables are validated at startup in `src/env.ts`; add new ones there first.

# Public (exposed to the browser; must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (never prefixed NEXT_PUBLIC_)
# DATABASE_URL=postgres://user:password@localhost:5432/app
